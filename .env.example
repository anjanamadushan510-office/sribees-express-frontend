# Copy to .env.local and adjust. `.env*` is gitignored except this template —
# never commit a filled-in .env.local.

# Base URL of the backend API. Note this app currently talks to the **Laravel**
# backend (Passport bearer tokens; see proxy.ts), NOT the FastAPI service at
# sribees-express-backend. Point it at whichever you are running.
#
# Local Laravel:  http://localhost:8000/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
