# Copy to .env.local and adjust. `.env*` is gitignored except this template —
# never commit a filled-in .env.local.

# Base URL of the FastAPI backend, INCLUDING the /api/v1 prefix.
#
# Defaults to the deployed development API when unset, so a fresh clone runs
# against a real backend with no setup. Point it at a local uvicorn instead
# with:  http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=https://devapiexpress.sribees.com/api/v1
